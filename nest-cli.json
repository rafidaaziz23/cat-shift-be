{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/cat-shift-be/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/cat-shift-be/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/cat-shift-be",
  "projects": {
    "cat-shift-be": {
      "type": "application",
      "root": "apps/cat-shift-be",
      "entryFile": "main",
      "sourceRoot": "apps/cat-shift-be/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cat-shift-be/tsconfig.app.json"
      }
    },
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "project-service": {
      "type": "application",
      "root": "apps/project-service",
      "entryFile": "main",
      "sourceRoot": "apps/project-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/project-service/tsconfig.app.json"
      }
    },
    "task-service": {
      "type": "application",
      "root": "apps/task-service",
      "entryFile": "main",
      "sourceRoot": "apps/task-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/task-service/tsconfig.app.json"
      }
    },
    "app": {
      "type": "application",
      "root": "apps/comment-service/app",
      "entryFile": "main",
      "sourceRoot": "apps/comment-service/app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/comment-service/app/tsconfig.app.json"
      }
    },
    "comment-service": {
      "type": "application",
      "root": "apps/comment-service",
      "entryFile": "main",
      "sourceRoot": "apps/comment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/comment-service/tsconfig.app.json"
      }
    },
    "shared-types": {
      "type": "library",
      "root": "libs/shared-types",
      "entryFile": "index",
      "sourceRoot": "libs/shared-types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-types/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "message-broker": {
      "type": "library",
      "root": "libs/message-broker",
      "entryFile": "index",
      "sourceRoot": "libs/message-broker/src",
      "compilerOptions": {
        "tsConfigPath": "libs/message-broker/tsconfig.lib.json"
      }
    },
    "log-service": {
      "type": "application",
      "root": "apps/log-service",
      "entryFile": "main",
      "sourceRoot": "apps/log-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/log-service/tsconfig.app.json"
      }
    }
  }
}